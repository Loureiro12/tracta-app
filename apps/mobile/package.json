{
  "name": "@tracta/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test e2e/flows",
    "e2e:smoke": "maestro test --include-tags smoke e2e/flows",
    "e2e:ios": "EXPO_PUBLIC_E2E=1 expo run:ios --configuration Release && maestro test e2e/flows",
    "e2e:android": "EXPO_PUBLIC_E2E=1 expo run:android --variant release && maestro test e2e/flows",
    "e2e:studio": "maestro studio",
    "clean": "rm -rf .turbo .expo node_modules ios android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "@tracta/api": "workspace:*",
    "@tracta/design-system": "workspace:*",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "i18next": "^26.5.11",
    "intl-pluralrules": "^2.0.1",
    "react": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-health-connect": "4.1.3",
    "react-native-maps": "1.29.11",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tracta/eslint-config": "workspace:*",
    "@tracta/tsconfig": "workspace:*",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3"
  }
}
