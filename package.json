{
  "name": "tracta",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @tracta/mobile start",
    "ios": "pnpm --filter @tracta/mobile ios",
    "android": "pnpm --filter @tracta/mobile android",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint -- --fix && eslint . --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @tracta/mobile e2e",
    "e2e:ios": "pnpm --filter @tracta/mobile e2e:ios",
    "e2e:android": "pnpm --filter @tracta/mobile e2e:android",
    "check:tests": "node tooling/scripts/check-tests.mjs",
    "check:flows": "node tooling/scripts/check-flows.mjs",
    "check:structure": "node tooling/scripts/check-structure.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:structure && pnpm check:flows && pnpm check:tests --base origin/main",
    "gen:feature": "node tooling/scripts/gen-feature.mjs",
    "gen:component": "node tooling/scripts/gen-component.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm --filter @tracta/api gen:types",
    "db:test": "supabase test db",
    "test:api": "pnpm --filter @tracta/api test",
    "test:backend": "supabase test db && pnpm --filter @tracta/api test",
    "gen:types": "pnpm --filter @tracta/api gen:types"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
