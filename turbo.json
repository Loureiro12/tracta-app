{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/eslint-config/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/tsconfig/**"]
    },
    "e2e": {
      "cache": false,
      "persistent": false
    },
    "clean": {
      "cache": false
    }
  }
}
