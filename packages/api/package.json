{
  "name": "@tracta/api",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Supabase access for Tracta: client factory, generated database types and domain repositories.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "gen:types": "cd ../.. && supabase gen types typescript --local --schema public > packages/api/src/database.types.ts && prettier --write packages/api/src/database.types.ts",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tracta/eslint-config": "workspace:*",
    "@tracta/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
